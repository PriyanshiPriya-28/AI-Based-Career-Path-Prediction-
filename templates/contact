<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Contact Us - CareerAI</title>


<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}


body{

    font-family:'Segoe UI',Arial,sans-serif;

    color:white;

    min-height:100vh;


    background:
    linear-gradient(
        120deg,
        rgba(15,47,99,0.9),
        rgba(2,4,53,0.95)
    ),
    url("{{ url_for('static', filename='Ai.png') }}");


    background-size:cover;

    background-position:center;

    background-attachment:fixed;


    display:flex;

    justify-content:center;

    align-items:center;

    padding:40px 20px;

}



/* MAIN */

.container{

    max-width:1100px;

    width:100%;

    text-align:center;

}




h1{

    font-size:48px;

    margin-bottom:15px;


    background:
    linear-gradient(
        to right,
        #ffffff,
        #4facfe
    );


    -webkit-background-clip:text;

    -webkit-text-fill-color:transparent;

}



.subtitle{

    font-size:18px;

    color:#dfefff;

    margin-bottom:50px;

}



/* CONTACT AREA */


.contact-section{


    display:flex;

    justify-content:center;

    gap:40px;

    flex-wrap:wrap;


}




/* CONTACT INFORMATION */


.contact-info{


    width:300px;

}



.card{


    background:
    rgba(255,255,255,0.08);


    backdrop-filter:blur(12px);


    border-radius:20px;


    padding:25px;


    margin-bottom:25px;


    border:1px solid rgba(255,255,255,0.2);


    transition:0.4s;


}



.card:hover{


    transform:translateY(-8px);


    box-shadow:
    0 15px 35px rgba(79,172,254,0.4);


}




.card .icon{


    font-size:40px;

    margin-bottom:10px;

}



.card h3{

    font-size:22px;

    margin-bottom:10px;

}



.card p{

    color:#dfefff;

}



/* FORM */


.form-container{


    width:450px;


    background:
    rgba(255,255,255,0.08);


    backdrop-filter:blur(12px);


    border-radius:20px;


    padding:35px;


    border:1px solid rgba(255,255,255,0.2);


}



.form-container h2{

    margin-bottom:25px;

}



input, textarea{


    width:100%;


    padding:15px;


    margin-bottom:15px;


    border:none;


    outline:none;


    border-radius:10px;


    background:
    rgba(255,255,255,0.15);


    color:white;


    font-size:15px;


}



input::placeholder,
textarea::placeholder{

    color:#dfefff;

}



textarea{

    height:130px;

    resize:none;

}




button{


    width:100%;


    padding:15px;


    border:none;


    border-radius:30px;


    background:#063e87;


    color:white;


    font-size:16px;


    font-weight:bold;


    cursor:pointer;


    transition:0.3s;


}



button:hover{


    background:white;


    color:#063e87;


}




/* BACK BUTTON */


.back-btn{


    display:inline-block;


    margin-top:40px;


    padding:12px 35px;


    background:#063e87;


    color:white;


    text-decoration:none;


    border-radius:5px;


    font-weight:bold;


    transition:0.3s;


}



.back-btn:hover{


    background:white;


    color:#063e87;


}




@media(max-width:700px){


.form-container{

    width:90%;

}


h1{

    font-size:35px;

}


}



</style>

</head>



<body>



<div class="container">


<h1>
Contact Us
</h1>


<p class="subtitle">
Connect with our AI Career Predictor team for any queries or support.
</p>




<div class="contact-section">



<div class="contact-info">


<div class="card">

<div class="icon">
📧
</div>

<h3>
Email
</h3>

<p>
careerai@gmail.com
</p>

</div>




<div class="card">

<div class="icon">
🤖
</div>

<h3>
AI Support
</h3>

<p>
Get help regarding career prediction and guidance.
</p>

</div>




<div class="card">

<div class="icon">
🚀
</div>

<h3>
Career Assistance
</h3>

<p>
We help students find the right career direction.
</p>

</div>


</div>






<div class="form-container">


<h2>
Send Message
</h2>


<form>


<input type="text" placeholder="Enter Your Name">


<input type="email" placeholder="Enter Your Email">


<textarea placeholder="Write Your Message"></textarea>


<button type="submit">
Send Message
</button>


</form>


</div>



</div>





<a href="{{ url_for('index') }}" class="back-btn">

Back to Home

</a>



</div>




</body>

</html>
